# El .env de dentro de la imagen de producción: valores por defecto, sin secretos. APP_SECRET,
# APP_KEYS_SECRET y DEFAULT_URI llegan por el entorno del contenedor (secrets.env).
APP_ENV=prod
APP_SECRET=
APP_SHARE_DIR=var/share
DEFAULT_URI=https://video-maker.code-hive.space
APP_KEYS_SECRET=
REGISTRO_ABIERTO=1
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
ANTHROPIC_MODEL=claude-opus-5-5
VIDEO_MODEL=balanced
MAX_PAID_CLIPS=5
