{% import '_icons.html.twig' as ui %}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}video-maker{% endblock %} · video-maker</title>
    <script>
        try { const t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect width='24' height='24' rx='7' fill='%236d4aff'/%3E%3Cpath d='M9 7v10l8-5z' fill='white'/%3E%3C/svg%3E">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap">
    <link rel="stylesheet" href="/app.css">
</head>
<body>
{% set route = app.request.attributes.get('_route') %}
<header class="top">
    <div class="top-in">
        <a class="brand" href="{{ path('home') }}"><span class="brand-mark">{{ ui.icon('play', 'icon-16') }}</span><span>video-maker</span></a>
        <nav class="top-tabs" aria-label="Secciones">
            <a class="top-tab" href="{{ path('video_new') }}" {{ route == 'video_new' ? 'aria-current="page"' }}>{{ ui.icon('sparkles') }}<span>Crear anuncio</span></a>
            <a class="top-tab" href="{{ path('video_list') }}" {{ route starts with 'video_' and route != 'video_new' ? 'aria-current="page"' }}>{{ ui.icon('film') }}<span>Mis vídeos</span></a>
            <a class="top-tab" href="{{ path('image_index') }}" {{ route starts with 'image_' ? 'aria-current="page"' }}>{{ ui.icon('image') }}<span>Imágenes</span></a>
        </nav>
        <span class="spacer"></span>
        <button type="button" class="icon-btn" data-theme-toggle aria-label="Cambiar entre modo claro y oscuro">{{ ui.icon('moon') }}</button>
    </div>
</header>
<main class="page">
    {% block body %}{% endblock %}
</main>
<div class="toasts" aria-live="polite" data-toasts></div>
<dialog class="dialog" data-confirm>
    <div class="dialog-body">
        <h2 data-confirm-title></h2>
        <p class="muted" data-confirm-text></p>
    </div>
    <div class="dialog-actions">
        <button type="button" class="btn btn-ghost btn-sm" data-confirm-cancel>Cancelar</button>
        <button type="button" class="btn btn-primary btn-sm" data-confirm-ok>Confirmar</button>
    </div>
</dialog>
<script src="/app.js"></script>
{% block scripts %}{% endblock %}
</body>
</html>
