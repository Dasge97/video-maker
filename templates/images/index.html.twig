{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as ui %}
{% block title %}Imágenes{% endblock %}
{% block body %}
<div class="make">
    <form data-create-form novalidate>
        <h1 class="ask"><label for="prompt">¿Qué imagen necesitas?</label></h1>
        <p class="ask-sub">La foto de quien sale o el logo de la marca. Después la usas en tu anuncio.</p>
        <div class="tgs" role="radiogroup" aria-label="Qué imagen es" style="margin-bottom: 14px">
            {% for key, k in kinds %}<button type="button" class="tg" role="radio" aria-checked="{{ (preset == key or (preset not in kinds|keys and loop.first)) ? 'true' : 'false' }}" data-kind="{{ key }}">{{ k.label }}</button>{% endfor %}
        </div>
        <input type="hidden" name="kind" value="{{ preset in kinds|keys ? preset : kinds|keys|first }}">
        <textarea class="big-input" id="prompt" name="prompt" maxlength="2000" style="min-height: 170px" placeholder="Mujer de unos 35 años, pelo castaño recogido, camisa blanca, sonriendo en una cafetería luminosa"></textarea>
        <p class="error" data-error-for="prompt" style="margin-top: 6px"></p>
        <div style="display: flex; align-items: center; gap: 12px; margin-top: 14px; flex-wrap: wrap">
            <label class="btn btn-ghost btn-sm">{{ ui.icon('upload', 'icon-16') }}<span data-source-name>Partir de una imagen</span><input class="sr-only" type="file" name="source" accept="image/jpeg,image/png,image/webp"></label>
            <span class="spacer"></span>
            <button type="submit" class="btn btn-primary" data-submit><span class="spinner"></span>{{ ui.icon('sparkles') }}Generar</button>
        </div>
        <p class="muted small" style="margin-top: 12px" data-kind-help></p>
        <p class="muted small">Unos {{ price|number_format(2, ',') }} $ por imagen. La misma descripción no se cobra dos veces.</p>
    </form>

    <section>
        <nav class="tabs" aria-label="Tipo" style="margin-top: 0">
            <a class="tab {{ kind is null ? 'on' }}" href="{{ path('image_index') }}">Todas <b>{{ counts.todas }}</b></a>
            {% for key, k in kinds %}{% if counts[key] > 0 %}<a class="tab {{ kind == key ? 'on' }}" href="{{ path('image_index', {tipo: key}) }}">{{ k.label }} <b>{{ counts[key] }}</b></a>{% endif %}{% endfor %}
        </nav>
        <div class="gallery" data-gallery>
            <div class="pic hidden" data-creating><div class="thumb" style="aspect-ratio: 1; border-radius: 0"><div class="bg g4"></div></div></div>
            {% for image in images %}
            <figure class="pic {{ image.kind == 'logo' ? 'logo' }}" style="margin: 0" title="{{ image.prompt }}">
                <img src="{{ path('image_file', {hash: image.hash}) }}" alt="{{ image.prompt }}" loading="lazy">
                <div class="pic-actions">
                    <a href="{{ path('video_new', {(image.kind == 'logo' ? 'logo' : 'person'): image.hash}) }}">Usar</a>
                    <button type="button" aria-label="Borrar imagen" data-post="{{ path('image_delete', {hash: image.hash}) }}" data-confirm-title="¿Borrar esta imagen?" data-confirm-text="Los vídeos que ya la usan la conservan." data-confirm-ok="Borrar" data-danger data-reload><span class="spinner"></span>{{ ui.icon('trash', 'icon-16') }}</button>
                </div>
            </figure>
            {% endfor %}
        </div>
        {% if images is empty %}
        <div class="empty" data-empty><span class="empty-ic">{{ ui.icon('image', 'icon-28') }}</span><b>Tu primera imagen está a una frase</b><span>Descríbela a la izquierda y aparecerá aquí.</span></div>
        {% endif %}
    </section>
</div>
{% endblock %}

{% block scripts %}
<script>
(() => {
  const form = document.querySelector('[data-create-form]');
  const hints = { person: 'Le añadimos «retrato realista, de frente, de medio cuerpo, mirando a cámara».', logo: 'Le añadimos «logotipo plano y simple, fondo transparente».', other: 'Se genera tal cual la describes.' };
  const setKind = (key) => {
    form.kind.value = key;
    form.querySelectorAll('[data-kind]').forEach((b) => b.setAttribute('aria-checked', String(b.dataset.kind === key)));
    form.querySelector('[data-kind-help]').textContent = hints[key];
  };
  form.querySelectorAll('[data-kind]').forEach((b) => b.addEventListener('click', () => setKind(b.dataset.kind)));
  setKind(form.kind.value);
  form.source.addEventListener('change', () => { form.querySelector('[data-source-name]').textContent = form.source.files[0]?.name ?? 'Partir de una imagen'; });
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    form.querySelector('[data-error-for="prompt"]').textContent = '';
    const creating = document.querySelector('[data-creating]');
    creating.classList.remove('hidden');
    document.querySelector('[data-empty]')?.classList.add('hidden');
    const result = await App.busy(form.querySelector('[data-submit]'), () => App.postForm('{{ path('image_create') }}', form));
    creating.classList.add('hidden');
    if (!result.ok) {
      form.querySelector('[data-error-for="prompt"]').textContent = App.firstError(result.errors);
      return;
    }
    location.reload();
  });
  form.prompt.addEventListener('keydown', (e) => { if (e.key === 'Enter' && e.ctrlKey) form.requestSubmit(); });
})();
</script>
{% endblock %}
