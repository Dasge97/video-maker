{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as ui %}
{% block title %}Entrar{% endblock %}
{% block body %}
<div class="auth">
    <form class="auth-card" method="post" action="{{ path('login') }}">
        <span class="auth-ic">{{ ui.icon('play', 'icon-28') }}</span>
        <h1 class="ask">Entra en video-maker</h1>
        <p class="ask-sub">Tus anuncios de Reels, hechos con tus propias claves.</p>
        {% if error %}<div class="notice bad" role="alert">{{ ui.icon('alert') }}<p>{{ error }}</p></div>{% endif %}
        <div>
            <label class="label" for="email">Correo</label>
            <input class="input" type="email" id="email" name="email" value="{{ email }}" autocomplete="email" required autofocus>
        </div>
        <div>
            <label class="label" for="password">Contraseña</label>
            <input class="input" type="password" id="password" name="password" autocomplete="current-password" required>
        </div>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <button type="submit" class="btn btn-primary btn-big">Entrar{{ ui.icon('arrow') }}</button>
        {% if signUpOpen %}<p class="muted small" style="text-align: center">¿Aún no tienes cuenta? <a href="{{ path('signup') }}">Créala aquí</a></p>{% endif %}
    </form>
</div>
{% endblock %}
