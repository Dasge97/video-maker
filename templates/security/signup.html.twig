{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as ui %}
{% block title %}Crear cuenta{% endblock %}
{% block body %}
<div class="auth">
    <form class="auth-card" method="post" action="{{ path('signup') }}" novalidate>
        <span class="auth-ic">{{ ui.icon('sparkles', 'icon-28') }}</span>
        <h1 class="ask">Crea tu cuenta</h1>
        <p class="ask-sub">Después pegas tus claves de Anthropic, ElevenLabs, fal.ai y OpenAI: cada vídeo lo pagas tú, directamente a ellos.</p>
        {% if errors[''] is defined %}<div class="notice bad" role="alert">{{ ui.icon('alert') }}<p>{{ errors[''] }}</p></div>{% endif %}
        <div>
            <label class="label" for="name">Nombre</label>
            <input class="input" id="name" name="name" value="{{ values.name }}" maxlength="80" autocomplete="name">
        </div>
        <div>
            <label class="label" for="email">Correo</label>
            <input class="input" type="email" id="email" name="email" value="{{ values.email }}" autocomplete="email" required>
            <p class="error">{{ errors.email ?? '' }}</p>
        </div>
        <div>
            <label class="label" for="password">Contraseña</label>
            <input class="input" type="password" id="password" name="password" autocomplete="new-password" minlength="{{ minPassword }}" required>
            <p class="error">{{ errors.password ?? '' }}</p>
            <p class="muted small">{{ minPassword }} caracteres como mínimo.</p>
        </div>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('signup') }}">
        <button type="submit" class="btn btn-primary btn-big">Crear cuenta{{ ui.icon('arrow') }}</button>
        <p class="muted small" style="text-align: center">¿Ya tienes cuenta? <a href="{{ path('login') }}">Entra</a></p>
    </form>
</div>
{% endblock %}
