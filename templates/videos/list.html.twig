{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as ui %}
{% block title %}Mis vídeos{% endblock %}
{% block crumbs %}<strong>Mis vídeos</strong>{% endblock %}
{% block body %}
<div class="page-head">
    <div>
        <h1>Mis vídeos</h1>
        <p>Todos tus anuncios: los que están en marcha, las propuestas que esperan tu visto bueno y los vídeos listos para publicar.</p>
    </div>
    <a class="btn btn-primary" href="{{ path('video_new') }}">{{ ui.icon('plus', 'icon-16') }}Nuevo anuncio</a>
</div>

<nav class="tabs" aria-label="Filtrar por estado">
    {% for key, label in {'todos': 'Todos', 'en-curso': 'En marcha', 'propuestas': 'Propuestas', 'listos': 'Listos', 'con-error': 'Con error'} %}
    <a class="tab {{ tab == key ? 'on' }}" href="{{ path('video_list', key == 'todos' ? {} : {estado: key}) }}" {{ tab == key ? 'aria-current="page"' }}>{{ label }} <span class="badge num">{{ counts[key] }}</span></a>
    {% endfor %}
</nav>

{% if jobs is empty %}
<div class="empty">
    {{ ui.icon('film') }}
    <h2>{{ tab == 'todos' ? 'Tu primer anuncio está a un paso' : 'Aquí no hay ningún vídeo' }}</h2>
    <p>{{ tab == 'todos' ? 'Sube un Reel que te guste, la foto de quien sale y tu logo. En unos minutos tienes la propuesta.' : 'Cambia de pestaña para ver los demás, o empieza uno nuevo.' }}</p>
    <a class="btn btn-primary" href="{{ path('video_new') }}">{{ ui.icon('plus', 'icon-16') }}Crear un anuncio</a>
</div>
{% else %}
<div class="gallery">
    {% for job in jobs %}
    {% set s = labels[job.status] ?? [job.status, 'info'] %}
    {% set poster = job.data.result ? path('video_file', {id: job.id, path: 'out/poster.jpg'}) : null %}
    <a class="tile" href="{{ path('video_show', {id: job.id}) }}">
        <div class="media" {% if poster %}style="background-image: url('{{ poster }}')"{% endif %}>
            {% if not poster %}{{ ui.icon('film') }}{% endif %}
        </div>
        <div class="body">
            <span class="badge badge-{{ s[1] }}"><span class="dot"></span>{{ s[0] }}</span>
            <p class="title">{{ job.data.input.brand.name ?: (job.data.input.product|length > 60 ? job.data.input.product|slice(0, 60) ~ '…' : job.data.input.product) }}</p>
            <p class="xs muted">{{ job.data.createdAt|date('d/m/Y H:i') }} · {{ job.data.input.durationSeconds }} s · {{ job.data.input.mode == 'voice_over' ? 'Voz en off' : 'Persona a cámara' }}</p>
        </div>
    </a>
    {% endfor %}
</div>
{% endif %}
{% endblock %}
