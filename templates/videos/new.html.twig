{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as ui %}
{% block title %}Crear anuncio{% endblock %}
{% block body %}
<form data-wizard novalidate>
    <div class="wiz-head">
        <button type="button" class="icon-btn" data-back aria-label="Paso anterior">{{ ui.icon('back') }}</button>
        <div class="progress" role="progressbar" aria-label="Pasos" aria-valuemin="1" aria-valuemax="5" data-progress>
            {% for n in 1..5 %}<span class="{{ n == 1 ? 'on' }}"></span>{% endfor %}
        </div>
    </div>

    {# 1 · La referencia #}
    <section class="wiz-step" data-step="1" aria-labelledby="ask-1">
        <h1 id="ask-1" class="ask">¿Qué anuncio te gusta?</h1>
        <p class="ask-sub">Imitamos su ritmo y sus planos con tu mensaje. Nunca copiamos sus textos ni sus personas.</p>
        <div class="tgs" role="radiogroup" aria-label="Cómo das la referencia" style="margin-bottom: 16px">
            <button type="button" class="tg" role="radio" aria-checked="true" data-ref-kind="file">{{ ui.icon('upload', 'icon-16') }}Subir vídeo</button>
            <button type="button" class="tg" role="radio" aria-checked="false" data-ref-kind="url">{{ ui.icon('link', 'icon-16') }}Pegar enlace</button>
        </div>
        <label class="drop" data-drop>
            <span class="plus" data-drop-icon>{{ ui.icon('film', 'icon-28') }}</span>
            <video class="hidden" muted playsinline preload="metadata" data-drop-preview></video>
            <span><b data-drop-name>Arrastra aquí el vídeo o haz clic para elegirlo</b><small>mp4, mov o webm · hasta 90 segundos y 200 MB</small></span>
            <input class="sr-only" type="file" name="reference" accept="video/mp4,video/quicktime,video/webm,.mp4,.mov,.webm">
        </label>
        <div class="hidden" data-url-box>
            <label class="sr-only" for="referenceUrl">Enlace del vídeo</label>
            <input class="big-url" type="url" id="referenceUrl" name="referenceUrl" inputmode="url" placeholder="https://www.instagram.com/reel/…">
            <p class="muted small" style="margin-top: 10px">Instagram, TikTok o YouTube. Si Instagram pide iniciar sesión, descarga el vídeo y súbelo.</p>
        </div>
    </section>

    {# 2 · La persona y la marca #}
    <section class="wiz-step hidden" data-step="2" aria-labelledby="ask-2">
        <h1 id="ask-2" class="ask">¿Quién sale y de qué marca?</h1>
        <p class="ask-sub">La cara del vídeo sale de la foto: mejor de frente y bien iluminada.</p>
        <div class="slots">
            {% for slot in [{name: 'person', title: 'La persona', icon: 'image', optional: false}, {name: 'logo', title: 'El logo', icon: 'sparkles', optional: true}] %}
            <button type="button" class="slot" data-slot="{{ slot.name }}">
                <span class="slot-head"><span class="ic">{{ ui.icon(slot.icon) }}</span>{{ slot.title }}{% if slot.optional %}<span class="opt">Opcional</span>{% endif %}</span>
                <span class="slot-empty" data-slot-empty><span class="plus">{{ ui.icon('plus') }}</span>Elegir</span>
                <span class="slot-body hidden {{ slot.name == 'logo' ? 'contain' }}" data-slot-body><span class="slot-change">{{ ui.icon('refresh', 'icon-16') }}Cambiar</span></span>
            </button>
            {% endfor %}
        </div>
        <input class="sr-only" type="file" name="person" accept="image/jpeg,image/png,image/webp" tabindex="-1">
        <input class="sr-only" type="file" name="logo" accept="image/jpeg,image/png,image/webp" tabindex="-1">
        <input type="hidden" name="personLibrary"><input type="hidden" name="logoLibrary">
        <div class="field-row">
            <div><label class="label" for="brandName">Marca</label><input class="input" id="brandName" name="brandName" maxlength="80" placeholder="Nombre de la marca"></div>
            <div><span class="label">Colores</span><div class="color-pair"><input type="color" name="color1" value="#6d4aff" aria-label="Color principal" data-color><input type="color" name="color2" value="#ffffff" aria-label="Color secundario" data-color><span class="muted small" style="align-self: center" data-colors-help>Salen del logo</span></div></div>
            <div><label class="label" for="font">Tipografía</label><select class="select" id="font" name="font">{% for font in fonts %}<option {{ font == 'Poppins' ? 'selected' }}>{{ font }}</option>{% endfor %}</select></div>
        </div>
    </section>

    {# 3 · Qué se anuncia #}
    <section class="wiz-step hidden" data-step="3" aria-labelledby="ask-3">
        <h1 id="ask-3" class="ask"><label for="product">¿Qué anuncias?</label></h1>
        <p class="ask-sub">El producto o servicio, el mensaje, el precio u oferta si quieres que salga y qué debe hacer quien lo vea. No inventamos cifras.</p>
        <textarea class="big-input" id="product" name="product" maxlength="1000" placeholder="Por ejemplo: Brisa, la botella con filtro que quita el sabor a cloro. 24,90 € con envío gratis. Pídela en brisa.es"></textarea>
        <div class="field-row two">
            <div><label class="label" for="note">Qué te gusta de la referencia (opcional)</label><input class="input" id="note" name="note" maxlength="1000" placeholder="El gancho del principio, los cortes rápidos…"></div>
            <div><label class="label" for="forbiddenWords">Palabras prohibidas (opcional)</label><input class="input" id="forbiddenWords" name="forbiddenWords" placeholder="barato, oferta"></div>
        </div>
    </section>

    {# 4 · Cómo se cuenta #}
    <section class="wiz-step hidden" data-step="4" aria-labelledby="ask-4">
        <h1 id="ask-4" class="ask">¿Cómo lo contamos?</h1>
        <div class="choices" role="radiogroup" aria-label="Quién habla" style="margin-top: 18px">
            <button type="button" class="choice" role="radio" aria-checked="true" data-mode="talking_person"><span class="check">{{ ui.icon('check', 'icon-16') }}</span><span class="ic">{{ ui.icon('mic', 'icon-28') }}</span><span><span class="name">La persona habla a cámara</span><span class="sub">Dice el mensaje con su voz, con planos de apoyo entre medias</span></span></button>
            <button type="button" class="choice" role="radio" aria-checked="false" data-mode="voice_over"><span class="check">{{ ui.icon('check', 'icon-16') }}</span><span class="ic">{{ ui.icon('message', 'icon-28') }}</span><span><span class="name">Voz en off</span><span class="sub">Un narrador cuenta el mensaje sobre planos generados</span></span></button>
        </div>
        <input type="hidden" name="mode" value="talking_person">
        <div class="field-row">
            <div>
                <label class="label" for="voiceId" data-voice-label>Voz de la persona</label>
                <div style="display: flex; gap: 8px">
                    <select class="select" id="voiceId" name="voiceId" data-voices><option value="{{ defaultVoice }}">Cargando voces…</option></select>
                    <button type="button" class="btn btn-ghost btn-sm" data-play-voice aria-label="Escuchar la voz"><span class="spinner"></span>{{ ui.icon('play', 'icon-16') }}</button>
                </div>
                <audio class="hidden" data-voice-audio></audio>
            </div>
            <div><span class="label">Duración</span><div class="tgs" role="radiogroup" aria-label="Duración" data-group="durationSeconds">{% for d in durations %}<button type="button" class="tg" role="radio" aria-checked="{{ d == 15 ? 'true' : 'false' }}" data-value="{{ d }}">{{ d }} s</button>{% endfor %}</div></div>
            <div><span class="label">Calidad de los clips</span><div class="tgs" role="radiogroup" aria-label="Calidad" data-group="model">{% for m in models|reverse %}<button type="button" class="tg" role="radio" aria-checked="{{ m.default ? 'true' : 'false' }}" data-value="{{ m.id }}" title="{{ m.model }}">{{ m.label }}</button>{% endfor %}</div></div>
        </div>
        <input type="hidden" name="durationSeconds" value="15"><input type="hidden" name="model" value="balanced">
        <div class="summary">{{ ui.icon('tag') }}<span data-summary></span></div>
    </section>
</form>

<div class="wiz-bar">
    <div class="wiz-bar-in">
        <button type="button" class="btn btn-ghost" data-back>{{ ui.icon('back') }}Atrás</button>
        <span class="spacer"></span>
        <span class="hint" data-hint></span>
        <button type="button" class="btn btn-primary btn-big" data-next><span class="spinner"></span><span data-next-label>Siguiente</span>{{ ui.icon('arrow') }}</button>
    </div>
</div>

<dialog class="dialog" data-picker>
    <div class="dialog-body">
        <h2 data-picker-title>Elige una imagen</h2>
        <div style="display: flex; gap: 10px; flex-wrap: wrap">
            <button type="button" class="btn btn-primary btn-sm" data-picker-upload>{{ ui.icon('upload', 'icon-16') }}Subir una imagen</button>
            <a class="btn btn-ghost btn-sm" href="{{ path('image_index') }}">{{ ui.icon('sparkles', 'icon-16') }}Crear con IA</a>
        </div>
        <span class="label" style="margin: 6px 0 0">O elige una de tus imágenes</span>
        <div class="picker" data-picker-grid></div>
        <p class="muted small hidden" data-picker-empty>Aún no has creado imágenes.</p>
    </div>
    <div class="dialog-actions"><button type="button" class="btn btn-ghost btn-sm" data-picker-close>Cerrar</button></div>
</dialog>
{% endblock %}

{% block scripts %}
<script>
(() => {
  const form = document.querySelector('[data-wizard]');
  const steps = [...form.querySelectorAll('[data-step]')];
  const hint = document.querySelector('[data-hint]');
  const next = document.querySelector('[data-next]');
  const params = new URLSearchParams(location.search);
  let step = 1;
  let refKind = 'file';

  function show(n) {
    step = n;
    steps.forEach((s) => s.classList.toggle('hidden', Number(s.dataset.step) !== n));
    form.querySelectorAll('[data-progress] span').forEach((s, i) => s.classList.toggle('on', i < n));
    document.querySelector('[data-next-label]').textContent = n === 4 ? 'Preparar la propuesta' : 'Siguiente';
    say('');
    if (n === 4) summary();
    window.scrollTo({ top: 0 });
  }
  function say(text, bad = true) { hint.textContent = text; hint.classList.toggle('bad', bad && !!text); }
  document.querySelectorAll('[data-back]').forEach((b) => b.addEventListener('click', () => (step > 1 ? show(step - 1) : (location.href = '{{ path('video_list') }}'))));

  // ---- 1 · reference: file (click or drop) or link ----
  const drop = form.querySelector('[data-drop]');
  const refInput = drop.querySelector('input[type=file]');
  form.querySelectorAll('[data-ref-kind]').forEach((b) => b.addEventListener('click', () => {
    refKind = b.dataset.refKind;
    form.querySelectorAll('[data-ref-kind]').forEach((o) => o.setAttribute('aria-checked', String(o === b)));
    drop.classList.toggle('hidden', refKind === 'url');
    form.querySelector('[data-url-box]').classList.toggle('hidden', refKind !== 'url');
    if (refKind === 'url') form.referenceUrl.focus();
  }));
  const showReference = () => {
    const file = refInput.files[0];
    if (!file) return;
    drop.querySelector('[data-drop-name]').textContent = file.name;
    const preview = drop.querySelector('[data-drop-preview]');
    preview.src = URL.createObjectURL(file);
    preview.classList.remove('hidden');
    drop.querySelector('[data-drop-icon]').classList.add('hidden');
  };
  refInput.addEventListener('change', showReference);
  ['dragenter', 'dragover'].forEach((e) => drop.addEventListener(e, (ev) => { ev.preventDefault(); drop.classList.add('over'); }));
  ['dragleave', 'drop'].forEach((e) => drop.addEventListener(e, () => drop.classList.remove('over')));
  drop.addEventListener('drop', (ev) => { ev.preventDefault(); if (ev.dataTransfer.files.length) { refInput.files = ev.dataTransfer.files; showReference(); } });

  // ---- 2 · person and logo: upload or library ----
  const picker = document.querySelector('[data-picker]');
  let pickFor = null;
  let library = null;
  const loadLibrary = async () => library ?? (library = ((await App.request('{{ path('image_list') }}')).data ?? []));
  function fill(field, url, name) {
    const slot = form.querySelector(`[data-slot="${field}"]`);
    slot.querySelector('[data-slot-empty]').classList.add('hidden');
    const body = slot.querySelector('[data-slot-body]');
    body.classList.remove('hidden');
    body.style.backgroundImage = `url("${url}")`;
    body.title = name;
  }
  async function colorsOf(payload) {
    const data = new FormData();
    Object.entries(payload).forEach(([k, v]) => data.append(k, v));
    const result = await App.postForm('{{ path('logo_colors') }}', data);
    const colors = result.ok ? result.data.colors : [];
    form.querySelectorAll('[data-color]').forEach((input, i) => { if (colors[i]) input.value = colors[i].toLowerCase(); });
    form.querySelector('[data-colors-help]').textContent = colors.length ? 'Del logo' : 'Elígelos tú';
  }
  function chooseLibrary(field, image) {
    form[`${field}Library`].value = image.hash;
    form[field].value = '';
    fill(field, image.url, image.prompt);
    if (field === 'logo') colorsOf({ hash: image.hash });
  }
  form.querySelectorAll('[data-slot]').forEach((slot) => slot.addEventListener('click', async () => {
    pickFor = slot.dataset.slot;
    document.querySelector('[data-picker-title]').textContent = pickFor === 'person' ? 'La foto de la persona' : 'El logo de la marca';
    const images = (await loadLibrary()).filter((i) => i.kind === (pickFor === 'person' ? 'person' : 'logo') || i.kind === 'other');
    picker.querySelector('[data-picker-grid]').innerHTML = images.map((i) => `<button type="button" data-hash="${i.hash}" title="${App.escape(i.prompt)}"><img src="${i.url}" alt="${App.escape(i.prompt)}" loading="lazy"></button>`).join('');
    picker.querySelector('[data-picker-empty]').classList.toggle('hidden', images.length > 0);
    picker.showModal();
  }));
  picker.querySelector('[data-picker-grid]').addEventListener('click', (e) => {
    const b = e.target.closest('[data-hash]');
    if (!b) return;
    chooseLibrary(pickFor, library.find((i) => i.hash === b.dataset.hash));
    picker.close();
  });
  picker.querySelector('[data-picker-upload]').addEventListener('click', () => { picker.close(); form[pickFor].click(); });
  picker.querySelector('[data-picker-close]').addEventListener('click', () => picker.close());
  ['person', 'logo'].forEach((field) => form[field].addEventListener('change', () => {
    const file = form[field].files[0];
    if (!file) return;
    form[`${field}Library`].value = '';
    fill(field, URL.createObjectURL(file), file.name);
    if (field === 'logo') colorsOf({ logo: file });
  }));
  (async () => {
    for (const field of ['person', 'logo']) {
      const hash = params.get(field);
      const image = hash && (await loadLibrary()).find((i) => i.hash === hash);
      if (image) chooseLibrary(field, image);
    }
  })();

  // ---- 4 · mode, voice, duration and quality ----
  form.querySelectorAll('[data-mode]').forEach((b) => b.addEventListener('click', () => {
    form.querySelectorAll('[data-mode]').forEach((o) => o.setAttribute('aria-checked', String(o === b)));
    form.mode.value = b.dataset.mode;
    form.querySelector('[data-voice-label]').textContent = b.dataset.mode === 'voice_over' ? 'Voz del narrador' : 'Voz de la persona';
    summary();
  }));
  form.querySelectorAll('[data-group]').forEach((group) => group.addEventListener('click', (e) => {
    const b = e.target.closest('[data-value]');
    if (!b) return;
    group.querySelectorAll('[data-value]').forEach((o) => o.setAttribute('aria-checked', String(o === b)));
    form[group.dataset.group].value = b.dataset.value;
    summary();
  }));
  const select = form.querySelector('[data-voices]');
  (async () => {
    const result = await App.request('{{ path('voice_list') }}');
    if (!result.ok) { select.innerHTML = '<option value="{{ defaultVoice }}">Voz por defecto</option>'; return; }
    const option = (v) => `<option value="${v.id}" ${v.id === '{{ defaultVoice }}' ? 'selected' : ''}>${App.escape(v.name.replace(/^Audicion( 2)? — /, ''))}${v.detail ? ' · ' + App.escape(v.detail) : ''}</option>`;
    const spanish = result.data.filter((v) => v.spanish);
    const others = result.data.filter((v) => !v.spanish);
    select.innerHTML = (spanish.length ? `<optgroup label="En castellano">${spanish.map(option).join('')}</optgroup>` : '') + `<optgroup label="Otras voces">${others.map(option).join('')}</optgroup>`;
    summary();
  })();
  select.addEventListener('change', summary);
  const audio = form.querySelector('[data-voice-audio]');
  form.querySelector('[data-play-voice]').addEventListener('click', (e) => App.busy(e.currentTarget, () => new Promise((resolve) => {
    audio.src = `/voces/${select.value}/muestra`;
    audio.oncanplay = () => { audio.play(); resolve(); };
    audio.onerror = () => { App.toast('No se ha podido escuchar esta voz.', 'danger'); resolve(); };
  })));
  function summary() {
    const voice = select.selectedOptions[0]?.textContent.split(' · ')[0] ?? '';
    const mode = form.mode.value === 'voice_over' ? 'voz en off' : 'la persona a cámara';
    const quality = form.querySelector('[data-group="model"] [aria-checked="true"]')?.textContent ?? '';
    form.querySelector('[data-summary]').innerHTML = `Un anuncio vertical de <b>${form.durationSeconds.value} s</b> con <b>${mode}</b>, voz de <b>${App.escape(voice)}</b> y calidad <b>${App.escape(quality.toLowerCase())}</b>`;
  }

  // ---- Next, with the check of each step ----
  function problem(n) {
    if (n === 1) {
      if (refKind === 'file' && !refInput.files.length) return 'Elige el vídeo de referencia.';
      if (refKind === 'url' && !/^https:\/\/\S+$/.test(form.referenceUrl.value.trim())) return 'Pega un enlace que empiece por https://.';
      if (refKind === 'file' && refInput.files[0].size > 200 * 1024 * 1024) return 'El vídeo ocupa más de 200 MB.';
    }
    if (n === 2 && !form.person.files.length && !form.personLibrary.value) return 'Elige la foto de la persona.';
    if (n === 3 && form.product.value.trim().length < 10) return 'Cuéntanos qué anuncias (10 caracteres como mínimo).';
    return '';
  }
  const STEP_OF = { reference: 1, referenceUrl: 1, person: 2, logo: 2, product: 3 };
  next.addEventListener('click', async () => {
    const issue = problem(step);
    if (issue) { say(issue); return; }
    if (step < 4) { show(step + 1); return; }
    const data = new FormData(form);
    if (refKind === 'url') data.delete('reference'); else data.delete('referenceUrl');
    say('Subiendo…', false);
    const result = await App.busy(next, () => App.postForm('{{ path('video_create') }}', data));
    if (!result.ok) {
      const [field, message] = Object.entries(result.errors)[0] ?? ['', 'Algo ha fallado.'];
      if (STEP_OF[field]) show(STEP_OF[field]);
      say(message);
      return;
    }
    location.href = result.data.url;
  });
  form.addEventListener('submit', (e) => e.preventDefault());
  form.product.addEventListener('keydown', (e) => { if (e.key === 'Enter' && e.ctrlKey) next.click(); });
  show(1);
})();
</script>
{% endblock %}
