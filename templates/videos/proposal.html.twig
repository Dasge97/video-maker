{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as ui %}
{% set input = job.data.input %}
{% set name = input.brand.name ?: 'Tu anuncio' %}
{% set kinds = {talking_person: ['Persona a cámara', 'mic', true], generated_clip: ['Clip', 'film', true], image_motion: ['Imagen con movimiento', 'image', false], text_card: ['Tarjeta de texto', 'type', false], logo_card: ['Logo', 'sparkles', false]} %}
{% set positions = {top: 'arriba', center: 'en el centro', bottom: 'abajo'} %}
{% set phase = job.status == 'failed' ? job.data.failedIn : job.status %}
{% set editable = job.status == 'proposal' %}
{% set modeLabel = input.mode == 'voice_over' ? 'Voz en off' : 'Persona a cámara' %}
{% block title %}Propuesta · {{ name }}{% endblock %}
{% block body %}
<div class="wiz-head">
    <a class="icon-btn" href="{{ path('video_list') }}" aria-label="Ir a Mis vídeos">{{ ui.icon('back') }}</a>
    <div class="progress" aria-hidden="true">{% for n in 1..5 %}<span class="{{ n <= (plan is null or phase == 'analysing' ? 5 : 5) ? 'on' }}"></span>{% endfor %}</div>
</div>

{% if plan is null or phase == 'analysing' %}
<section class="wait" aria-live="polite">
    <span class="wait-ic">{{ ui.icon('sparkles', 'icon-28') }}</span>
    <h1 class="ask" data-wait-title>El agente está preparando tu propuesta</h1>
    <p class="wait-now" data-wait-now>Mirando la referencia plano a plano…</p>
    <ul class="wait-steps" data-wait-steps></ul>
    <div class="notice bad hidden" data-error>{{ ui.icon('alert') }}<span data-error-text></span><span class="spacer"></span><button type="button" class="btn btn-ghost btn-sm" data-post="{{ path('video_retry', {id: job.id}) }}" data-reload><span class="spinner"></span>{{ ui.icon('refresh', 'icon-16') }}Reintentar</button></div>
    <p class="muted small" data-waiting></p>
</section>
{% else %}

<div class="title-row">
    <h1 class="ask">Tu propuesta</h1>
    <span class="badge accent">Versión {{ job.data.plan.version }}{{ job.data.plan.by == 'person' ? ' · tuya' : '' }}</span>
    <span class="badge">{{ input.durationSeconds }} s · {{ modeLabel }}</span>
</div>
<p class="ask-sub">{{ plan.summary }}</p>

<div class="notices">
    {% if job.status == 'revising' %}<p class="notice">{{ ui.icon('clock') }}El agente está aplicando tu cambio. La propuesta se actualiza sola.</p>{% endif %}
    {% if job.status == 'failed' %}<div class="notice bad">{{ ui.icon('alert') }}<span>{{ job.data.error.message }}</span><span class="spacer"></span><button type="button" class="btn btn-ghost btn-sm" data-post="{{ path('video_retry', {id: job.id}) }}" data-reload><span class="spinner"></span>{{ ui.icon('refresh', 'icon-16') }}Reintentar</button></div>{% endif %}
    {% if job.status in ['generating', 'ready'] %}<p class="notice">{{ ui.icon('info') }}<span>Esta propuesta ya se ha usado para el vídeo. Para cambiar textos, ve a <a href="{{ path('video_video', {id: job.id}) }}">tu vídeo</a> y pulsa «Editar textos».</span></p>{% endif %}
    {% for warning in job.data.warnings ?? [] %}<p class="notice warn">{{ ui.icon('alert') }}{{ warning }}</p>{% endfor %}
    <div class="notice bad hidden" data-errors>{{ ui.icon('alert') }}<span data-errors-text></span></div>
</div>

<div class="review">
    <div class="preview-col">
        <div class="phone">
            <div class="thumb">
                {% if job.data.result %}<img src="{{ path('video_file', {id: job.id, path: 'out/poster.jpg'}) }}" alt="">{% elseif frames[0] is defined %}<img src="{{ path('video_file', {id: job.id, path: 'reference/' ~ frames[0].path}) }}" alt="" style="filter: saturate(0.6) brightness(0.8)">{% else %}<div class="bg g{{ (job.id|length % 6) + 1 }}"></div>{% endif %}
                <div class="label">{{ name }}<small>{{ input.durationSeconds }} s · vertical 9:16</small></div>
            </div>
        </div>
    </div>

    <div class="main-col">
        <form data-plan-form novalidate>
        <div class="clips">
            {% for piece in plan.pieces %}
            {% set i = loop.index0 %}
            {% set kind = kinds[piece.kind] ?? [piece.kind, 'film', false] %}
            {% set frame = piece.scene.imitateFrame ?? null %}
            {% set cost = 0 %}
            {% for line in job.data.estimate.lines ?? [] %}{% if line.piece is same as(i) %}{% set cost = cost + line.usd %}{% endif %}{% endfor %}
            {% set onScreen = [] %}
            {% for o in plan.overlays %}{% if o.kind != 'logo' and o.fromPiece <= loop.parent.loop.index and o.toPiece >= loop.parent.loop.index %}{% set onScreen = onScreen|merge([o.text]) %}{% endif %}{% endfor %}
            <article class="clip" data-piece="{{ i }}" data-seconds="{{ piece.plannedSeconds }}">
                <div class="clip-top">
                    <div class="clip-thumb">
                        <div class="thumb">{% if frame is not null and frames[frame] is defined %}<img src="{{ path('video_file', {id: job.id, path: 'reference/' ~ frames[frame].path}) }}" alt="Plano de la referencia que imita">{% else %}<div class="bg g{{ (i % 6) + 1 }}"></div>{% endif %}</div>
                        <span class="clip-n">{{ loop.index }}</span>
                        <span class="clip-d num">{{ piece.plannedSeconds|number_format(1, ',') }} s</span>
                    </div>
                    <div class="clip-main">
                        <div class="clip-head">
                            <b>{{ piece.title }}</b>
                            <span class="kind {{ kind[2] ? 'paid' }}">{{ ui.icon(kind[1], 'icon-16') }}{{ kind[0] }}</span>
                            <div class="clip-actions">
                                <span class="clip-cost num">{{ cost > 0 ? cost|number_format(2, ',') ~ ' $' : '' }}</span>
                                {% if editable %}<button type="button" class="edit-btn" aria-pressed="false" aria-label="Editar la pieza {{ loop.index }}" data-edit>{{ ui.icon('pencil', 'icon-16') }}</button>{% endif %}
                            </div>
                        </div>
                        <p class="error" data-error-for="pieces.{{ i }}"></p>
                        <div class="cf">
                            <span class="lbl">{{ ui.icon('mic', 'icon-16') }}Voz</span>
                            <div>
                                <p class="view-only {{ piece.voice ? '' : 'none' }}">{{ piece.voice ?: 'Sin voz' }}</p>
                                <div class="edit-only"><textarea rows="2" maxlength="300" data-path="pieces.{{ i }}.voice" data-voice data-nullable placeholder="Sin voz">{{ piece.voice }}</textarea></div>
                                <p class="count num" data-count></p>
                                <p class="error" data-error-for="pieces.{{ i }}.voice"></p>
                            </div>
                        </div>
                        {% if piece.scene is defined and piece.scene %}
                        <div class="cf">
                            <span class="lbl">{{ ui.icon('eye', 'icon-16') }}Se ve</span>
                            <div>
                                <p class="view-only">{{ piece.scene.action }}</p>
                                <div class="edit-only"><textarea rows="2" maxlength="800" data-path="pieces.{{ i }}.scene.action">{{ piece.scene.action }}</textarea></div>
                                <p class="error" data-error-for="pieces.{{ i }}.scene.action"></p>
                            </div>
                        </div>
                        {% if piece.scene.startImage is not null or piece.kind in ['talking_person', 'image_motion'] %}
                        <div class="cf edit-only">
                            <span class="lbl">{{ ui.icon('image', 'icon-16') }}Inicio</span>
                            <div><textarea rows="2" maxlength="800" data-path="pieces.{{ i }}.scene.startImage" data-nullable placeholder="Primer fotograma">{{ piece.scene.startImage }}</textarea><p class="error" data-error-for="pieces.{{ i }}.scene.startImage"></p></div>
                        </div>
                        {% endif %}
                        {% endif %}
                        {% set ownText = piece.card.text ?? piece.logo.text ?? null %}
                        {% if ownText is not null or onScreen %}
                        <div class="cf">
                            <span class="lbl">{{ ui.icon('type', 'icon-16') }}Texto</span>
                            <div>
                                <p class="view-only">{% if ownText %}<span class="quote">«{{ ownText }}»</span> {% endif %}{% for t in onScreen %}<span class="quote">«{{ t }}»</span> {% endfor %}</p>
                                {% if piece.card is defined and piece.card %}<div class="edit-only"><input maxlength="60" data-path="pieces.{{ i }}.card.text" value="{{ piece.card.text }}" aria-label="Texto de la tarjeta"></div><p class="error" data-error-for="pieces.{{ i }}.card.text"></p>{% endif %}
                                {% if piece.logo is defined and piece.logo %}<div class="edit-only"><input maxlength="40" data-path="pieces.{{ i }}.logo.text" value="{{ piece.logo.text }}" aria-label="Texto bajo el logo" placeholder="Sin texto"></div><p class="error" data-error-for="pieces.{{ i }}.logo.text"></p>{% endif %}
                            </div>
                        </div>
                        {% endif %}
                    </div>
                </div>
            </article>
            {% endfor %}
        </div>

        <details class="panel">
            <summary>{{ ui.icon('type') }}Rótulos, música y subtítulos<span class="chev">{{ ui.icon('chev') }}</span></summary>
            <div class="panel-body">
                {% for o in plan.overlays %}
                {% set k = loop.index0 %}
                {% if o.kind == 'logo' %}
                <p class="muted small">Logo pequeño en la esquina, de la pieza {{ o.fromPiece }} a la {{ o.toPiece }}.</p><p class="error" data-error-for="overlays.{{ k }}"></p>
                {% else %}
                <div class="overlay-row">
                    <div><label class="label" for="ov-{{ k }}">{{ {hook: 'Gancho', label: 'Rótulo', price: 'Precio', cta: 'Llamada a la acción'}[o.kind] ?? o.kind }}</label><input class="input" id="ov-{{ k }}" maxlength="40" data-path="overlays.{{ k }}.text" value="{{ o.text }}" {{ editable ? '' : 'readonly' }}></div>
                    <div><label class="label" for="ovp-{{ k }}">Dónde</label><select class="select" id="ovp-{{ k }}" data-path="overlays.{{ k }}.position" {{ editable ? '' : 'disabled' }}>{% for p, l in {top: 'Arriba', center: 'Centro', bottom: 'Abajo'} %}<option value="{{ p }}" {{ o.position == p ? 'selected' }}>{{ l }}</option>{% endfor %}</select></div>
                    <div><label class="label" for="ovf-{{ k }}">Desde</label><input class="input num" type="number" min="1" max="{{ plan.pieces|length }}" id="ovf-{{ k }}" data-path="overlays.{{ k }}.fromPiece" data-int value="{{ o.fromPiece }}" {{ editable ? '' : 'readonly' }}></div>
                    <div><label class="label" for="ovt-{{ k }}">Hasta</label><input class="input num" type="number" min="1" max="{{ plan.pieces|length }}" id="ovt-{{ k }}" data-path="overlays.{{ k }}.toPiece" data-int value="{{ o.toPiece }}" {{ editable ? '' : 'readonly' }}></div>
                </div>
                <p class="error" data-error-for="overlays.{{ k }}"></p><p class="error" data-error-for="overlays.{{ k }}.text"></p>
                {% endif %}
                {% endfor %}
                {% if plan.music %}
                <div class="field-row two" style="margin-top: 4px">
                    <div><label class="label" for="music-style">Música</label><input class="input" id="music-style" maxlength="120" data-path="music.style" value="{{ plan.music.style }}" {{ editable ? '' : 'readonly' }}></div>
                    <div><label class="label" for="music-mood">Ánimo</label><input class="input" id="music-mood" maxlength="120" data-path="music.mood" value="{{ plan.music.mood }}" {{ editable ? '' : 'readonly' }}></div>
                </div>
                {% endif %}
                <label class="tgs small"><input type="checkbox" data-path="subtitles" data-bool {{ plan.subtitles ? 'checked' }} {{ editable ? '' : 'disabled' }}> Subtítulos palabra a palabra</label>
            </div>
        </details>

        <details class="panel">
            <summary>{{ ui.icon('film') }}Lo que tomamos de la referencia<span class="chev">{{ ui.icon('chev') }}</span></summary>
            <div class="panel-body">
                <p>{{ plan.reference.summary }}</p>
                <p class="muted small">{{ plan.reference.rhythm }}</p>
                <div class="beats">
                    {% for beat in plan.reference.beats %}
                    <figure class="beat" style="margin: 0">
                        <div class="thumb">{% if beat.frame is not null and frames[beat.frame] is defined %}<img src="{{ path('video_file', {id: job.id, path: 'reference/' ~ frames[beat.frame].path}) }}" alt="{{ beat.what }}" loading="lazy">{% endif %}</div>
                        <p><b class="num">{{ beat.start|number_format(0) }}–{{ beat.end|number_format(0) }} s</b> {{ beat.what }}</p>
                    </figure>
                    {% endfor %}
                </div>
            </div>
        </details>
        </form>

        {% if editable %}
        <form class="ask-change" data-revise-form>
            <textarea name="change" maxlength="600" aria-label="Pide un cambio al agente" placeholder="Pide un cambio: «que el gancho sea una pregunta», «quita el precio», «más planos de la botella»…"></textarea>
            <button type="submit" class="btn btn-primary" data-revise><span class="spinner"></span>{{ ui.icon('send') }}Pedir cambio</button>
        </form>
        {% if plan.questions ?? [] %}<div class="chips">{% for q in plan.questions %}<button type="button" class="chip" data-suggestion>{{ ui.icon('sparkles', 'icon-16') }}{{ q }}</button>{% endfor %}</div>{% endif %}
        {% endif %}
    </div>
</div>

<div class="wiz-bar">
    <div class="wiz-bar-in">
        <a class="btn btn-ghost" href="{{ path('video_list') }}">{{ ui.icon('back') }}Atrás</a>
        <span class="spacer"></span>
        <span class="hint" data-hint></span>
        <div class="bar-cost">
            <button type="button" data-cost-toggle aria-expanded="false"><span>Coste estimado</span><b class="num" data-cost-total>{{ (job.data.estimate.usd ?? 0)|number_format(2, ',') }} $</b>{{ ui.icon('chev', 'icon-16') }}</button>
            <div class="cost-pop hidden" data-cost-pop>
                <ul class="cost-lines num" data-cost-lines>{% for line in job.data.estimate.lines ?? [] %}<li><span>{{ line.what }}</span><span>{{ line.usd|number_format(2, ',') }} $</span></li>{% endfor %}</ul>
                <p class="muted small" style="margin-top: 8px">Lo ya hecho no se vuelve a pagar. Llevas {{ job.totalCost|number_format(2, ',') }} $ en este vídeo.</p>
            </div>
        </div>
        {% if editable %}
        <button type="button" class="btn btn-ghost hidden" data-save><span class="spinner"></span>{{ ui.icon('check') }}Guardar</button>
        <button type="button" class="btn btn-primary btn-big" data-generate><span class="spinner"></span>{{ ui.icon('sparkles') }}Generar vídeo</button>
        {% elseif job.status in ['generating', 'ready'] %}
        <a class="btn btn-primary btn-big" href="{{ path('video_video', {id: job.id}) }}">Ver el vídeo{{ ui.icon('arrow') }}</a>
        {% endif %}
    </div>
</div>
<script type="application/json" id="plan-data">{{ plan|json_encode(constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_HEX_TAG'))|raw }}</script>
{% endif %}
{% endblock %}

{% block scripts %}
<script>
(() => {
  const stateUrl = '{{ path('video_state', {id: job.id}) }}';
  const version = {{ job.data.plan.version ?? 'null' }};
  const status = '{{ job.status }}';

  // ---- While the agent works ----
  const waitSteps = document.querySelector('[data-wait-steps]');
  if (waitSteps || status === 'revising') {
    App.poll(stateUrl, (s) => {
      if (waitSteps) {
        waitSteps.innerHTML = s.steps.map((st) => `<li class="${st.state}"><span class="dot ${st.state === 'current' ? 'run' : st.state === 'done' ? '' : st.state === 'failed' ? 'bad' : 'idle'}"></span>${App.escape(st.label)}</li>`).join('');
        const now = s.steps.find((st) => st.state === 'current' || st.state === 'failed');
        if (now) document.querySelector('[data-wait-now]').textContent = `${now.label}…`;
        const error = document.querySelector('[data-error]');
        error.classList.toggle('hidden', !s.error);
        if (s.error) { error.querySelector('[data-error-text]').textContent = s.error; document.querySelector('[data-wait-title]').textContent = 'No se ha podido preparar la propuesta'; }
        document.querySelector('[data-waiting]').textContent = s.waiting ? 'Un proveedor está ocupado: lo volvemos a intentar en unos segundos.' : '';
      }
      if (s.status === 'proposal' || (s.planVersion !== version && s.status !== 'revising')) { location.reload(); return false; }
      return s.status !== 'failed';
    });
  }

  const form = document.querySelector('[data-plan-form]');
  if (!form) return;
  const costToggle = document.querySelector('[data-cost-toggle]');
  const costPop = document.querySelector('[data-cost-pop]');
  costToggle.addEventListener('click', () => { const open = costPop.classList.toggle('hidden') === false; costToggle.setAttribute('aria-expanded', String(open)); });
  document.addEventListener('click', (e) => { if (!e.target.closest('.bar-cost')) { costPop.classList.add('hidden'); costToggle.setAttribute('aria-expanded', 'false'); } });
  if (status !== 'proposal') return;

  const plan = JSON.parse(document.getElementById('plan-data').textContent);
  const hint = document.querySelector('[data-hint]');
  const saveButton = document.querySelector('[data-save]');
  let dirty = false;

  // ---- Edit a piece in place ----
  form.querySelectorAll('[data-edit]').forEach((b) => b.addEventListener('click', () => {
    const clip = b.closest('.clip');
    const on = !clip.classList.contains('editing');
    clip.classList.toggle('editing', on);
    b.setAttribute('aria-pressed', String(on));
    if (on) clip.querySelector('textarea, input')?.focus();
  }));

  // ---- Words of the voice against the seconds of its piece, as PlanChecks counts them ----
  function count(textarea) {
    const seconds = parseFloat(textarea.closest('[data-piece]').dataset.seconds);
    const n = App.words(textarea.value);
    const max = Math.floor(seconds * {{ maxWordsPerSecond }} + 1e-9);
    const out = textarea.closest('.cf').querySelector('[data-count]');
    out.textContent = n ? `${n} palabras · caben ${max}` : '';
    out.classList.toggle('over', n > max);
  }
  form.querySelectorAll('[data-voice]').forEach((t) => { count(t); t.addEventListener('input', () => count(t)); });
  const changed = () => { dirty = true; saveButton.classList.remove('hidden'); hint.textContent = 'Tienes cambios sin guardar'; hint.classList.remove('bad'); };
  form.addEventListener('input', changed);
  form.addEventListener('change', changed);

  function collect() {
    const copy = structuredClone(plan);
    form.querySelectorAll('[data-path]').forEach((el) => {
      const keys = el.dataset.path.split('.');
      let target = copy;
      keys.slice(0, -1).forEach((k) => { target = target[k]; });
      let value = el.value;
      if ('bool' in el.dataset) value = el.checked;
      else if ('int' in el.dataset) value = parseInt(value, 10) || 0;
      else if ('nullable' in el.dataset && value.trim() === '') value = null;
      target[keys[keys.length - 1]] = value;
    });
    return copy;
  }

  function showErrors(errors) {
    form.querySelectorAll('[data-error-for]').forEach((s) => { s.textContent = ''; });
    const general = [];
    Object.entries(errors).forEach(([pointer, message]) => {
      const key = pointer.replace(/^\//, '').replaceAll('/', '.');
      const slot = form.querySelector(`[data-error-for="${CSS.escape(key)}"]`);
      if (slot) {
        slot.textContent = message;
        const clip = slot.closest('.clip');
        if (clip) { clip.classList.add('editing'); clip.querySelector('[data-edit]')?.setAttribute('aria-pressed', 'true'); }
        if (slot.closest('details')) slot.closest('details').open = true;
      } else general.push(message);
    });
    const box = document.querySelector('[data-errors]');
    box.classList.toggle('hidden', !general.length);
    box.querySelector('[data-errors-text]').textContent = general.join(' ');
    (form.querySelector('[data-error-for]:not(:empty)') ?? (general.length ? box : null))?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  async function save() {
    const result = await App.busy(saveButton, () => App.postJson('{{ path('video_plan_save', {id: job.id}) }}', collect()));
    if (!result.ok) {
      showErrors(result.errors);
      hint.textContent = result.status === 422 ? 'No se ha guardado: revisa lo marcado' : App.firstError(result.errors);
      hint.classList.add('bad');
      return false;
    }
    dirty = false;
    location.reload();
    return true;
  }
  saveButton.addEventListener('click', save);

  document.querySelector('[data-generate]').addEventListener('click', async (e) => {
    if (dirty) {
      const result = await App.busy(saveButton, () => App.postJson('{{ path('video_plan_save', {id: job.id}) }}', collect()));
      if (!result.ok) { showErrors(result.errors); hint.textContent = 'Revisa lo marcado antes de generar'; hint.classList.add('bad'); return; }
      dirty = false;
      document.querySelector('[data-cost-total]').textContent = App.money(result.data.estimate.usd);
    }
    const total = document.querySelector('[data-cost-total]').textContent;
    if (!(await App.confirm('¿Generamos el vídeo?', `Cuesta unos ${total} y tarda unos minutos.`, 'Generar vídeo'))) return;
    const result = await App.busy(e.currentTarget, () => App.request('{{ path('video_generate', {id: job.id}) }}', { method: 'POST' }));
    if (!result.ok) { App.toast(App.firstError(result.errors), 'danger'); return; }
    location.href = result.data.url;
  });

  const revise = document.querySelector('[data-revise-form]');
  document.querySelectorAll('[data-suggestion]').forEach((chip) => chip.addEventListener('click', () => { revise.change.value = chip.textContent.trim(); revise.change.focus(); }));
  revise.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (dirty && !(await App.confirm('Tienes cambios sin guardar', 'Si pides un cambio al agente, se pierden tus ediciones.', 'Pedir cambio'))) return;
    const result = await App.busy(revise.querySelector('[data-revise]'), () => App.postForm('{{ path('video_revise', {id: job.id}) }}', revise));
    if (!result.ok) { App.toast(App.firstError(result.errors), 'danger'); return; }
    dirty = false;
    location.reload();
  });
  revise.change.addEventListener('keydown', (e) => { if (e.key === 'Enter' && e.ctrlKey) revise.requestSubmit(); });
  window.addEventListener('beforeunload', (e) => { if (dirty) e.preventDefault(); });
})();
</script>
{% endblock %}
