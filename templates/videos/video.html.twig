{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as ui %}
{% set input = job.data.input %}
{% set name = input.brand.name ?: 'Tu anuncio' %}
{% set ready = job.status == 'ready' %}
{% block title %}Vídeo · {{ name }}{% endblock %}
{% block body %}
<div class="wiz-head">
    <a class="icon-btn" href="{{ path('video_proposal', {id: job.id}) }}" aria-label="Volver a la propuesta">{{ ui.icon('back') }}</a>
    <div class="progress" aria-hidden="true">{% for n in 1..5 %}<span class="on"></span>{% endfor %}</div>
</div>

<section class="gen">
    <div class="preview-col">
        <div class="phone">
            <div class="thumb">
                {% if ready %}
                <video src="{{ path('video_file', {id: job.id, path: 'out/video.mp4'}) }}" poster="{{ path('video_file', {id: job.id, path: 'out/poster.jpg'}) }}" controls playsinline preload="metadata"></video>
                {% else %}
                <div class="bg g{{ (job.id|length % 6) + 1 }}"></div>
                <div class="label">{{ name }}<small>{{ input.durationSeconds }} s · vertical 9:16</small></div>
                {% endif %}
            </div>
        </div>
    </div>

    <div>
        {% if ready %}
        <h1 class="ask">¡Tu anuncio está listo!</h1>
        <p class="ask-sub">{{ job.data.result.durationSeconds|number_format(1, ',') }} segundos en vertical, con voz, subtítulos y música. Descárgalo y súbelo como Reel.</p>
        <div class="notices">{% for warning in job.data.warnings ?? [] %}<p class="notice warn">{{ ui.icon('alert') }}{{ warning }}</p>{% endfor %}</div>
        <details class="panel" style="max-width: 520px">
            <summary>Coste real <b class="num" style="color: var(--accent)">{{ job.totalCost|number_format(2, ',') }} $</b><span class="chev">{{ ui.icon('chev') }}</span></summary>
            <div class="panel-body"><ul class="cost-lines num">{% for c in job.data.costs %}<li><span>{{ c.what }}</span><span>{{ c.usd|number_format(3, ',') }} $</span></li>{% endfor %}</ul></div>
        </details>
        <div class="gen-actions">
            <a class="btn btn-primary btn-big" href="{{ path('video_file', {id: job.id, path: 'out/video.mp4', descargar: 1}) }}">{{ ui.icon('download') }}Descargar</a>
            <button type="button" class="btn btn-ghost" data-post="{{ path('video_edit', {id: job.id}) }}"><span class="spinner"></span>{{ ui.icon('pencil') }}Editar textos</button>
            <a class="btn btn-ghost" href="{{ path('video_list') }}">{{ ui.icon('film') }}Mis vídeos</a>
            <button type="button" class="btn btn-danger" data-post="{{ path('video_delete', {id: job.id}) }}" data-confirm-title="¿Borrar este vídeo?" data-confirm-text="Se borran el vídeo, la propuesta y todo lo generado. No se puede deshacer." data-confirm-ok="Borrar" data-danger aria-label="Borrar vídeo"><span class="spinner"></span>{{ ui.icon('trash') }}</button>
        </div>
        <p class="muted small" style="margin-top: 14px">Cambiar rótulos o música y volver a montar es gratis. Lo que no cambia se reutiliza.</p>
        {% else %}
        <h1 class="ask" data-title>Generando tu anuncio…</h1>
        <div class="gen-bar" role="progressbar" aria-label="Progreso" aria-valuemin="0" aria-valuemax="100"><span data-bar style="width: 4%"></span></div>
        <p class="gen-text" data-text>Primero la voz, que marca cuánto dura cada pieza.</p>
        <ul class="gen-steps" data-steps></ul>
        <div class="gen-thumbs" data-thumbs></div>
        <div class="notice bad hidden" data-error style="margin-top: 18px">{{ ui.icon('alert') }}<span data-error-text></span></div>
        <p class="muted small" data-waiting style="margin-top: 10px"></p>
        <div class="gen-actions">
            <button type="button" class="btn btn-primary hidden" data-retry data-post="{{ path('video_retry', {id: job.id}) }}" data-reload><span class="spinner"></span>{{ ui.icon('refresh') }}Reintentar</button>
            <button type="button" class="btn btn-ghost hidden" data-back-proposal data-post="{{ path('video_edit', {id: job.id}) }}"><span class="spinner"></span>{{ ui.icon('back') }}Volver a la propuesta</button>
            <a class="btn btn-ghost" href="{{ path('video_list') }}">{{ ui.icon('film') }}Mis vídeos</a>
        </div>
        <p class="muted small" style="margin-top: 14px">Tarda entre 3 y 10 minutos. Puedes cerrar esta página: el trabajo sigue.</p>
        {% endif %}
    </div>
</section>
{% endblock %}

{% block scripts %}
{% if not ready %}
<script>
(() => {
  const icons = { done: '<svg class="icon" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>', current: '<span class="spinner"></span>', failed: '<svg class="icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>', pending: '<svg class="icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/></svg>' };
  const TEXT = { voice: 'Leyendo la voz, que marca cuánto dura cada pieza…', images: 'Haciendo las imágenes de arranque…', clips: 'Generando los clips en fal.ai (unos 2 minutos cada tanda)…', music: 'Componiendo la música…', assemble: 'Montando el vídeo…' };
  const shown = new Set();
  App.poll('{{ path('video_state', {id: job.id}) }}', (s) => {
    const done = s.steps.filter((st) => st.state === 'done').length;
    const clipsShare = s.clips && s.clips.total ? s.clips.done / s.clips.total : 0;
    const percent = Math.round(((done + (s.step === 'clips' ? clipsShare : 0)) / Math.max(1, s.steps.length)) * 100);
    document.querySelector('[data-bar]').style.width = `${Math.max(4, percent)}%`;
    document.querySelector('[data-steps]').innerHTML = s.steps.map((st) => {
      const extra = st.name === 'clips' && s.clips ? ` (${s.clips.done} de ${s.clips.total})` : '';
      return `<li class="${st.state}">${icons[st.state]}${App.escape(st.label + extra)}</li>`;
    }).join('');
    if (TEXT[s.step]) document.querySelector('[data-text]').textContent = TEXT[s.step];
    s.images.filter((u) => !shown.has(u)).forEach((u) => { shown.add(u); document.querySelector('[data-thumbs]').insertAdjacentHTML('beforeend', `<img src="${u}" alt="Imagen de arranque de una pieza">`); });
    const failed = s.status === 'failed';
    document.querySelector('[data-error]').classList.toggle('hidden', !failed);
    if (failed) { document.querySelector('[data-error-text]').textContent = s.error; document.querySelector('[data-title]').textContent = 'No se ha podido generar'; }
    document.querySelector('[data-retry]').classList.toggle('hidden', !failed);
    document.querySelector('[data-back-proposal]').classList.toggle('hidden', !failed);
    document.querySelector('[data-waiting]').textContent = s.waiting ? 'Un proveedor está ocupado: lo volvemos a intentar en unos segundos.' : '';
    if (s.status === 'ready') { location.reload(); return false; }
    if (s.status === 'proposal') { location.href = '{{ path('video_proposal', {id: job.id}) }}'; return false; }
    return !failed;
  }, 3000);
})();
</script>
{% endif %}
{% endblock %}
